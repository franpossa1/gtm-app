# Configure locally. Never paste the key into chat or source control.
ANTHROPIC_API_KEY=
# Optional override; when blank, the Claude Agent SDK chooses its default.
CLAUDE_MODEL=
# Required positive per-request USD budget. Reported costs are estimates.
RUN_BUDGET_USD=
# Optional absolute directories outside source. Defaults use local user app data.
DATA_DIR=
AGENT_WORK_DIR=
RESEARCH_CONCURRENCY=2
# fast (default): shallow pass — 1 round, A/B/C in parallel, 1 search + up to 3 sources each, D without web.
# full: original spec limits (2 rounds, 5+5 tools, 120 s per task, RESEARCH_CONCURRENCY applies).
RESEARCH_MODE=fast
# Model for fast mode (alias haiku/sonnet/opus or full id). Default: haiku.
CLAUDE_RESEARCH_MODEL=

# Legacy explicit budget (runtime reads .env/.env.local, never this template).
SPIKE_MAX_BUDGET_USD=20
